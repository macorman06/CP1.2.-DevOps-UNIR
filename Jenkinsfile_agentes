pipeline {
    agent none

    stages {

        stage('Get Code') {
            agent { label 'principal' }
            steps {
                sh 'whoami && hostname && echo ${WORKSPACE}'
                git branch: 'feature/fix-coverage',
                    url: 'https://github.com/macorman06/CP1.2.-DevOps-UNIR.git'
                stash name: 'source-code', includes: '**/*'
            }
            post {
                always { deleteDir() }
            }
        }

        stage('Tests') {
            parallel {

                stage('Unit') {
                    agent { label 'agent1' }
                    steps {
                        sh 'whoami && hostname && echo ${WORKSPACE}'
                        unstash 'source-code'
                        sh '''
                            mkdir -p reports
                            python3 -m pytest test/unit \
                                --junitxml=reports/unit.xml \
                                -v
                        '''
                    }
                    post {
                        always {
                            junit 'reports/unit.xml'
                            deleteDir()
                        }
                    }
                }

                stage('Rest') {
                    agent { label 'agent1' }
                    steps {
                        sh 'whoami && hostname && echo ${WORKSPACE}'
                        unstash 'source-code'
                        sh '''
                            mkdir -p reports

                            export FLASK_APP=app/api.py
                            flask run --host=0.0.0.0 --port=5000 &
                            FLASK_PID=$!

                            java -jar /opt/wiremock.jar \
                                --port 9090 \
                                --root-dir test/wiremock \
                                --no-request-journal &
                            WIREMOCK_PID=$!

                            for i in $(seq 1 30); do
                                curl -s http://localhost:5000 > /dev/null 2>&1 && break
                                sleep 1
                            done

                            for i in $(seq 1 30); do
                                curl -s http://localhost:9090/__admin/mappings > /dev/null 2>&1 && break
                                sleep 1
                            done

                            python3 -m pytest test/rest \
                                --junitxml=reports/rest.xml \
                                -v

                            kill $FLASK_PID $WIREMOCK_PID || true
                        '''
                    }
                    post {
                        always {
                            junit 'reports/rest.xml'
                            deleteDir()
                        }
                    }
                }

                stage('Static') {
                    agent { label 'agent1' }
                    steps {
                        sh 'whoami && hostname && echo ${WORKSPACE}'
                        unstash 'source-code'
                        sh '''
                            mkdir -p reports
                            python3 -m flake8 \
                                --format=pylint \
                                app > reports/flake8.out || true
                        '''
                    }
                    post {
                        always {
                            recordIssues(
                                tools: [flake8(pattern: 'reports/flake8.out')],
                                qualityGates: [
                                    [threshold: 8,  type: 'TOTAL', unstable: true],
                                    [threshold: 10, type: 'TOTAL', unstable: false]
                                ]
                            )
                            deleteDir()
                        }
                    }
                }

                stage('Security') {
                    agent { label 'agent1' }
                    steps {
                        sh 'whoami && hostname && echo ${WORKSPACE}'
                        unstash 'source-code'
                        sh '''
                            mkdir -p reports
                            python3 -m bandit \
                                -r app \
                                -f custom \
                                -o reports/bandit.out \
                                --msg-template "{abspath}:{line}: [{test_id}] {msg}" || true
                        '''
                    }
                    post {
                        always {
                            recordIssues(
                                tools: [pyLint(pattern: 'reports/bandit.out')],
                                qualityGates: [
                                    [threshold: 2, type: 'TOTAL', unstable: true],
                                    [threshold: 4, type: 'TOTAL', unstable: false]
                                ]
                            )
                            deleteDir()
                        }
                    }
                }

            }
        }

        stage('Coverage') {
            agent { label 'agent1' }
            steps {
                sh 'whoami && hostname && echo ${WORKSPACE}'
                unstash 'source-code'
                sh '''
                    mkdir -p reports
                    python3 -m pytest \
                        --cov=app \
                        --cov-report=xml:reports/coverage.xml \
                        --cov-report=html:reports/coverage_html \
                        --cov-branch \
                        test/unit \
                        -v
                '''
            }
            post {
                always {
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'reports/coverage.xml']],
                        qualityGates: [
                            [threshold: 100.0, metric: 'LINE',   baseline: 'PROJECT', unstable: true],
                            [threshold: 100.0, metric: 'LINE',   baseline: 'PROJECT', unstable: false],
                            [threshold: 100.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: true],
                            [threshold: 100.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: false]
                        ]
                    )
                    deleteDir()
                }
            }
        }

        stage('Performance') {
            agent { label 'agent2' }
            steps {
                sh 'whoami && hostname && echo ${WORKSPACE}'
                unstash 'source-code'
                sh '''
                    mkdir -p reports

                    export FLASK_APP=app/api.py
                    flask run --host=0.0.0.0 --port=5000 &
                    FLASK_PID=$!

                    for i in $(seq 1 30); do
                        curl -s http://localhost:5000 > /dev/null 2>&1 && break
                        sleep 1
                    done

                    jmeter -n \
                        -t test/jmeter/flask.jmx \
                        -l reports/jmeter.jtl \
                        -e -o reports/jmeter_html

                    kill $FLASK_PID || true
                '''
            }
            post {
                always {
                    perfReport sourceDataFiles: 'reports/jmeter.jtl'
                    deleteDir()
                }
            }
        }

    }
}
